{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Retail Projects - Odoo 17",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "python": "${workspaceFolder}/venv/bin/python",
            "args": [
                "-c",
                "${workspaceFolder}/config/odoo.conf",
                "--dev=xml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
